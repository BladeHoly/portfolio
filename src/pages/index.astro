---
import '@glass-midas/components/styles.css';
import '../styles/space.css';
import { FACES, PERSPECTIVE, SIDE, faceTransform } from '../scene/stages';

// Phase 2: the whole outer journey on placeholder content. Nothing here is final copy; every
// text is marked as a placeholder on purpose, and the door stays shut until phase 4.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es" style={`--side: ${SIDE}px; --perspective: ${PERSPECTIVE}px`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo · prototipo espacial</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
  </head>
  <body>
    <div class="viewport">
      <div class="world">
        {
          FACES.map((face, i) => (
            <section
              class:list={['face', { door: face.door }]}
              style={`transform: ${faceTransform(face)}`}
              aria-label={face.label}
            >
              <div class="face-body">
                <p class="eyebrow">
                  {face.label} · <span class="placeholder">placeholder</span>
                </p>
                <h2>{face.door ? 'Puerta cerrada' : 'Contenido pendiente'}</h2>
                <p class="note">
                  {face.door
                    ? 'Debajo del cubo se abre el recorrido interior. La apertura se diseña en la fase 4.'
                    : 'Esta cara existe para probar la cámara. Qué va aquí se decide con Renzo en la fase de contenido.'}
                </p>
                {i === 0 && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <gm-surface class="probe" material="frost" radius="22">
                      <p>Vidrio de glass-midas sobre capas en profundidad.</p>
                      <gm-button>
                        <button type="button">Botón de prueba</button>
                      </gm-button>
                    </gm-surface>
                  </div>
                )}
                {i > 0 && !face.door && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <span class="layer near" aria-hidden="true" />
                  </div>
                )}
                {face.door && <span class="seam" aria-hidden="true" />}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <!-- One snap point per stage. They hold the scroll length; the camera reads it. -->
    <div class="stops" aria-hidden="true">
      {FACES.map(() => <div class="stop" />)}
    </div>

    <output class="debug" hidden aria-live="off">Mové la cámara para medir</output>

    <script>
      import '../scene/run';
    </script>
  </body>
</html>
