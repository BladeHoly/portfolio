---
import Hero from '../components/Hero';
import Nav from '../components/Nav';
import Projects from '../components/Projects';
import { contact, jobs, projects, stack } from '../data/content';
import '../styles/global.css';

// BASE_URL has no trailing slash when a base path is set.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo — desarrollador</title>
    <meta
      name="description"
      content="Renzo, desarrollador en Paysandú, Uruguay. Proyectos en TypeScript y Rust, y glass-midas, vidrio líquido para la web."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#trabajo">Saltar al contenido</a>
    <Nav client:load />

    <header id="top" class="hero">
      <h1 class="visually-hidden">Renzo, desarrollador</h1>
      <Hero client:only="react" />
      <p class="intro">
        Desarrollador en Paysandú, Uruguay. Trabajo en Mozart Fintech, y en mi tiempo libre construyo
        herramientas: desde desarmar los archivos de un videojuego hasta vidrio que refracta en el
        navegador.
      </p>
    </header>

    <main>
      <section id="trabajo" aria-labelledby="trabajo-titulo">
        <h2 id="trabajo-titulo">Trabajo</h2>
        <ol class="jobs">
          {
            jobs.map((job) => (
              <li class="job">
                <p class="job-dates">
                  Desde {job.start}
                  {job.end && ` hasta ${job.end}`}
                </p>
                <h3>
                  {job.role ? `${job.role} en ` : ''}
                  {job.company}
                </h3>
                {job.summary && <p>{job.summary}</p>}
              </li>
            ))
          }
        </ol>
      </section>

      <section id="proyectos" aria-labelledby="proyectos-titulo">
        <h2 id="proyectos-titulo">Proyectos</h2>
        <Projects client:load projects={projects} />
      </section>

      <section id="stack" aria-labelledby="stack-titulo">
        <h2 id="stack-titulo">Stack</h2>
        <dl class="stack">
          {
            stack.map((group) => (
              <div>
                <dt>{group.area}</dt>
                <dd>{group.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section id="contacto" aria-labelledby="contacto-titulo">
        <h2 id="contacto-titulo">Contacto</h2>
        <p class="contact-lead">
          ¿Un proyecto, una pregunta o una oferta? Escribime y te respondo.
        </p>
        <ul class="contact">
          <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
          <li><a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
          <li><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        </ul>
      </section>
    </main>

    <footer class="footer">
      <p>
        Hecho con <a href="https://github.com/BladeHoly/glass-midas">glass-midas</a>. El vidrio de
        esta página refracta de verdad lo que tiene detrás.
      </p>
    </footer>
  </body>
</html>
