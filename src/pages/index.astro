---
import '@glass-midas/components/styles.css';
import '../styles/space.css';
import { person, projects } from '../data/content';
import Contact from '../faces/Contact.astro';
import Intro from '../faces/Intro.astro';
import Project from '../faces/Project.astro';
import Projects from '../faces/Projects.astro';
import Stack from '../faces/Stack.astro';
import Work from '../faces/Work.astro';
import { DOOR, FACES, PERSPECTIVE, SIDE, faceTransform } from '../scene/stages';

// Outside, the overview: who Renzo is, his work, his projects at a glance, his stack and how to
// reach him. Through the door, one project per face, the ceiling first.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const insideProject = (i: number) => projects[i - DOOR - 1];
---

<!doctype html>
<html lang="es" style={`--side: ${SIDE}px; --perspective: ${PERSPECTIVE}px`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo, desarrollador</title>
    <meta name="description" content={person.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
  </head>
  <body>
    <div class="viewport">
      <div class="world">
        {
          FACES.map((face, i) => {
            const nav = (
              <nav class="face-nav" aria-label="Seguir">
                {i > 0 && <a class="gm-chip" href={`#${FACES[i - 1].id}`}>↑ {FACES[i - 1].label}</a>}
                {i < FACES.length - 1 && <a class="gm-chip" href={`#${FACES[i + 1].id}`}>{FACES[i + 1].label} ↓</a>}
                {face.door && <a class="gm-chip" href={`#${FACES[0].id}`}>Volver arriba</a>}
                {i === FACES.length - 1 && <a class="gm-chip" href={`#${FACES[0].id}`}>Volver afuera</a>}
              </nav>
            );
            return (
              <section
                class:list={['face', { door: face.door, inside: face.inside }]}
                style={`transform: ${faceTransform(face)}`}
                aria-label={face.label}
              >
                {face.door ? (
                  // Two leaves with panels and handles; the text rides on the first one and swings
                  // away with it. They open towards the camera, onto the inside of the cube.
                  <>
                    <div class="leaf first">
                      <span class="panel" aria-hidden="true" />
                      <span class="handle" aria-hidden="true" />
                      <div class="face-body door-body">
                        <p class="eyebrow">Proyectos</p>
                        <h2>En profundidad</h2>
                        <p class="note">Detrás de esta puerta, cada proyecto en detalle.</p>
                        {nav}
                      </div>
                    </div>
                    <div class="leaf second">
                      <span class="panel" aria-hidden="true" />
                      <span class="handle" aria-hidden="true" />
                    </div>
                  </>
                ) : (
                  <div class="face-body">
                    {face.id === 'cara-1' && <Intro />}
                    {face.id === 'cara-2' && <Work />}
                    {face.id === 'cara-3' && <Projects />}
                    {face.id === 'cara-4' && <Stack />}
                    {face.id === 'cara-5' && <Contact />}
                    {face.inside && <Project project={insideProject(i)} />}
                    {nav}
                  </div>
                )}
              </section>
            );
          })
        }
      </div>
    </div>

    <!-- One snap point per stage. They hold the scroll length, and give each face its address. -->
    <div class="stops" aria-hidden="true">
      {FACES.map((face) => <div class="stop" id={face.id} />)}
    </div>

    <!-- The rail: every stage in the order of the journey, outside then inside, on glass-midas
         glass, marking where you are. -->
    <nav class="map" aria-label="Caras">
      <gm-surface material="frost" radius="999" class="map-glass">
        <ol>
          {
            FACES.map((face, i) => (
              <>
                {face.inside && !FACES[i - 1].inside && <li class="map-gap" aria-hidden="true" />}
                <li>
                  <a class="gm-chip" href={`#${face.id}`} data-stage={i} aria-label={face.label}>
                    {face.inside ? i - DOOR : i + 1}
                  </a>
                </li>
              </>
            ))
          }
        </ol>
      </gm-surface>
    </nav>

    <output class="debug" hidden aria-live="off">Mové la cámara para medir</output>

    <script>
      import '../scene/run';
    </script>
  </body>
</html>
