---
import '@glass-midas/components/styles.css';
import '../styles/space.css';
import { DOOR, FACES, PERSPECTIVE, SIDE, faceTransform } from '../scene/stages';

// The whole journey, outside and in, on placeholder content. Nothing here is final copy;
// every text is marked as a placeholder on purpose.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="es" style={`--side: ${SIDE}px; --perspective: ${PERSPECTIVE}px`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo · prototipo espacial</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
  </head>
  <body>
    <div class="viewport">
      <div class="world">
        {
          FACES.map((face, i) => (
            <section
              class:list={['face', { door: face.door, inside: face.inside }]}
              style={`transform: ${faceTransform(face)}`}
              aria-label={face.label}
            >
              <div class="face-body">
                <p class="eyebrow">
                  {face.label} · <span class="placeholder">placeholder</span>
                </p>
                <h2>{face.door ? 'Puerta' : 'Contenido pendiente'}</h2>
                <p class="note">
                  {face.door
                    ? 'Seguí: el recorrido continúa dentro del cubo.'
                    : 'Esta cara existe para probar la cámara. Qué va aquí se decide con Renzo en la fase de contenido.'}
                </p>
                {i === 0 && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <gm-surface class="probe" material="frost" radius="22">
                      <p>Vidrio de glass-midas sobre capas en profundidad.</p>
                      <gm-button>
                        <button type="button">Botón de prueba</button>
                      </gm-button>
                    </gm-surface>
                  </div>
                )}
                {i > 0 && !face.door && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <span class="layer near" aria-hidden="true" />
                  </div>
                )}
                {/* Contextual navigation: where to go from here. */}
                <nav class="face-nav" aria-label="Seguir">
                  {i > 0 && <a class="gm-chip" href={`#${FACES[i - 1].id}`}>↑ {FACES[i - 1].label}</a>}
                  {i < FACES.length - 1 && <a class="gm-chip" href={`#${FACES[i + 1].id}`}>{FACES[i + 1].label} ↓</a>}
                  {face.door && <a class="gm-chip" href={`#${FACES[0].id}`}>Volver arriba</a>}
                  {i === FACES.length - 1 && <a class="gm-chip" href={`#${FACES[0].id}`}>Volver afuera</a>}
                </nav>
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <!-- The door's black hole: it opens over the screen while the camera falls through. -->
    <div class="void" aria-hidden="true"></div>

    <!-- One snap point per stage. They hold the scroll length, and give each face its address. -->
    <div class="stops" aria-hidden="true">
      {FACES.map((face) => <div class="stop" id={face.id} />)}
    </div>

    <!-- The rail: every stage in the order of the journey, outside then inside, on glass-midas
         glass, marking where you are. -->
    <nav class="map" aria-label="Caras">
      <gm-surface material="frost" radius="999" class="map-glass">
        <ol>
          {
            FACES.map((face, i) => (
              <>
                {face.inside && !FACES[i - 1].inside && <li class="map-gap" aria-hidden="true" />}
                <li>
                  <a class="gm-chip" href={`#${face.id}`} data-stage={i} aria-label={face.label}>
                    {face.inside ? i - DOOR : i + 1}
                  </a>
                </li>
              </>
            ))
          }
        </ol>
      </gm-surface>
    </nav>

    <output class="debug" hidden aria-live="off">Mové la cámara para medir</output>

    <script>
      import '../scene/run';
    </script>
  </body>
</html>
