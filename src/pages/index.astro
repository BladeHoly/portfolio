---
import Backdrop from '../components/Backdrop';
import GlassBox from '../components/GlassBox';
import Navbar, { slug } from '../components/Navbar';
import { contact, jobs, projects, stack } from '../data/content';
import '../styles/global.css';

// BASE_URL has no trailing slash when a base path is set.
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const STATUS = {
  público: 'Código abierto',
  'pronto público': 'Código abierto pronto',
  privado: 'Código privado',
} as const;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo, desarrollador</title>
    <meta
      name="description"
      content="Renzo, desarrollador en Paysandú, Uruguay. Proyectos en TypeScript y Rust, y glass-midas, vidrio líquido para la web."
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#trabajo">Saltar al contenido</a>
    <Backdrop client:only="react" />
    <Navbar client:load projects={projects} />

    <header id="top" class="hero">
      <h1>Renzo</h1>
      <p class="intro">
        Desarrollador en Paysandú, Uruguay. Trabajo en Mozart Fintech, y en mi tiempo libre construyo
        herramientas: desde desarmar los archivos de un videojuego hasta vidrio que refracta en el
        navegador.
      </p>
      <div class="actions">
        <GlassBox client:load as="a" href="#proyectos" className="button" glass={{ radius: 999 }}>
          Ver proyectos
        </GlassBox>
        <GlassBox
          client:load
          as="a"
          href={`mailto:${contact.email}`}
          className="button"
          glass={{ radius: 999 }}
        >
          Escribime
        </GlassBox>
      </div>
    </header>

    <main>
      <section id="trabajo" aria-labelledby="trabajo-titulo">
        <h2 id="trabajo-titulo">Trabajo</h2>
        <ol class="jobs">
          {
            jobs.map((job) => (
              <li>
                <GlassBox client:visible as="article" className="panel job">
                  <p class="job-dates">
                    Desde {job.start}
                    {job.end && ` hasta ${job.end}`}
                  </p>
                  <h3>
                    {job.role ? `${job.role} en ` : ''}
                    {job.company}
                  </h3>
                  {job.summary && <p>{job.summary}</p>}
                </GlassBox>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="proyectos" aria-labelledby="proyectos-titulo">
        <h2 id="proyectos-titulo">Proyectos</h2>
        <ul class="projects">
          {
            projects.map((p, i) => (
              <li class={i === 0 ? 'featured' : undefined}>
                <GlassBox
                  client:visible
                  as="article"
                  id={`proyecto-${slug(p.name)}`}
                  className="panel project"
                >
                  <h3>
                    {p.url ? (
                      <a href={p.url} target="_blank" rel="noopener noreferrer">
                        {p.name}
                      </a>
                    ) : (
                      p.name
                    )}
                  </h3>
                  <p>{p.what}</p>
                  <p class="project-meta">
                    <span>{p.stack.join(', ')}</span>
                    <span class={p.status === 'público' ? 'status-open' : undefined}>
                      {STATUS[p.status]}
                    </span>
                  </p>
                </GlassBox>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="stack" aria-labelledby="stack-titulo">
        <h2 id="stack-titulo">Stack</h2>
        <GlassBox client:visible className="panel">
          <dl class="stack">
            {
              stack.map((group) => (
                <div>
                  <dt>{group.area}</dt>
                  <dd>{group.items.join(', ')}</dd>
                </div>
              ))
            }
          </dl>
        </GlassBox>
      </section>

      <section id="contacto" aria-labelledby="contacto-titulo">
        <h2 id="contacto-titulo">Contacto</h2>
        <p class="contact-lead">¿Un proyecto, una pregunta o una oferta? Escribime y te respondo.</p>
        <ul class="contact">
          <li>
            <GlassBox client:visible as="a" href={`mailto:${contact.email}`} className="button" glass={{ radius: 999 }}>
              {contact.email}
            </GlassBox>
          </li>
          <li>
            <GlassBox client:visible as="a" href={contact.github} className="button" glass={{ radius: 999 }}>
              GitHub
            </GlassBox>
          </li>
          <li>
            <GlassBox client:visible as="a" href={contact.linkedin} className="button" glass={{ radius: 999 }}>
              LinkedIn
            </GlassBox>
          </li>
        </ul>
      </section>
    </main>

    <footer class="footer">
      <p>
        Hecho con <a href="https://github.com/BladeHoly/glass-midas">glass-midas</a>. Cada vidrio de
        esta página refracta de verdad lo que tiene detrás.
      </p>
    </footer>
  </body>
</html>
