---
import '@glass-midas/components/styles.css';
import '../styles/space.css';
import { FACES, PERSPECTIVE, SIDE, faceTransform } from '../scene/stages';

// Phase 1 prototype: the camera, the staged scroll and one kind of transition, on placeholder
// content. Nothing here is final copy; every text is marked as a placeholder on purpose.
---

<!doctype html>
<html lang="es" style={`--side: ${SIDE}px; --perspective: ${PERSPECTIVE}px`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Renzo · prototipo espacial</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
    />
  </head>
  <body>
    <div class="viewport">
      <div class="world">
        {
          FACES.map((face, i) => (
            <section class="face" style={`transform: ${faceTransform(face)}`} aria-label={face.label}>
              <div class="face-body">
                <p class="eyebrow">
                  {face.label} · <span class="placeholder">placeholder</span>
                </p>
                <h2>Contenido pendiente</h2>
                <p class="note">
                  Esta cara existe para probar la cámara. Qué va aquí se decide con Renzo en la fase de
                  contenido.
                </p>
                {i === 0 && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <gm-surface class="probe" material="frost" radius="22">
                      <p>Vidrio de prueba sobre capas en profundidad.</p>
                      <gm-button>
                        <button type="button">Botón de prueba</button>
                      </gm-button>
                    </gm-surface>
                  </div>
                )}
                {i > 0 && (
                  <div class="depth">
                    <span class="layer far" aria-hidden="true" />
                    <span class="layer mid" aria-hidden="true" />
                    <span class="layer near" aria-hidden="true" />
                  </div>
                )}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <!-- One snap point per stage. They hold the scroll length; the camera reads it. -->
    <div class="stops" aria-hidden="true">
      {FACES.map(() => <div class="stop" />)}
    </div>

    <aside class="lab" aria-label="Controles del prototipo">
      <div role="group" aria-label="Curva">
        <span>Curva</span>
        <button type="button" data-key="curve" value="nativa">Nativa</button>
        <button type="button" data-key="curve" value="suave">Suave</button>
      </div>
      <div role="group" aria-label="Trayectoria">
        <span>Ruta</span>
        <button type="button" data-key="path" value="orbita">Órbita</button>
        <button type="button" data-key="path" value="deslizar">Deslizar</button>
      </div>
      <div role="group" aria-label="Rueda">
        <span>Rueda</span>
        <button type="button" data-key="wheel" value="etapas">Etapas</button>
        <button type="button" data-key="wheel" value="nativa">Nativa</button>
      </div>
      <output aria-live="off">Mové la cámara para medir</output>
    </aside>

    <script>
      import '../scene/run';
    </script>
  </body>
</html>
