---
import { data, ui, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { jobs } = data[lang];
const t = ui[lang];
---

<h2>{t.faces['cara-2']}</h2>
{
  jobs.map((job) => (
    <gm-surface class="job pane" material="frost" radius="32" tier="blur">
      <h3>{job.company}</h3>
      <p class="meta">
        {job.role && `${job.role} · `}
        {t.since} {job.start}
        {job.end && ` ${t.until} ${job.end}`}
      </p>
      <p>{job.summary}</p>
    </gm-surface>
  ))
}
