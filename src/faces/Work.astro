---
import { jobs } from '../data/content';
---

<h2>Trabajo</h2>
{
  jobs.map((job) => (
    <gm-surface class="job" material="frost" radius="24">
      <h3>{job.company}</h3>
      <p class="meta">
        {job.role && `${job.role} · `}desde {job.start}
        {job.end && ` hasta ${job.end}`}
      </p>
      <p>{job.summary}</p>
    </gm-surface>
  ))
}
